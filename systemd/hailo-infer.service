[Unit]
Description=Hailo Infer Service
After=network.target

[Service]
Type=simple
User=ray
WorkingDirectory=/home/ray/hailo-infer
Environment=PORT=3002
Environment=UPLOAD_DIR=/home/ray/uploads
Environment=META_DIR=/tmp
Environment=DATA_DIR=/home/ray/data
Environment=CAMERA_BASE_URL=http://127.0.0.1:3001
ExecStart=/home/ray/hailo-infer/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 3002
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
